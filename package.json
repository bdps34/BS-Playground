{
  "name": "bs-playground",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "server": "tsx watch --include \"server/**/*.ts\" server/server.ts",
    "start:server": "tsx server/server.ts",
    "lint": "ng lint"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "argon2": "^0.41.0",
    "cors": "^2.8.6",
    "dotenv": "^16.0.0",
    "express": "^5.1.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^27.1.0",
    "pino-pretty": "^13.0.0",
    "puppeteer-core": "^25.11.0",
    "sass": "^1.99.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^4.0.8"
  }
}
